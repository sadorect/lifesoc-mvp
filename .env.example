# Copy this file to .env.local for local development
# Never put real credentials here — this file is committed to git

ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (audiobook narration — scripts/generate-audiobook-tts.mjs)
OPENAI_API_KEY=sk-...
# Optional overrides, defaults shown:
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=echo

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=zerotrust-audiobook
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Book redemption
BOOK_ACCESS_CODE=your_access_code# Per-reviewer codes, name:CODE pairs (skip the question, never lapse)
REVIEWER_CODES=ada:REVIEW-ADA-XXXX

# Optional: extra origins accepted on Clerk tokens, comma-separated
# EXTRA_AUTHORIZED_PARTIES=https://staging.lifesoc.app
